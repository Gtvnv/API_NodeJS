{
  "name": "node-ts-webapi-podcast-manager",
  "version": "1.0.0",
  "description": "Gerenciador de Podcasts - API REST em Node.js com TypeScript usando apenas o modulo HTTP nativo, sem frameworks.",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format cjs --clean",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "http",
    "rest-api",
    "podcast",
    "no-framework",
    "dio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
